#!/usr/bin/env bash

set -euo pipefail

script_path="${BASH_SOURCE[0]}"

while [ -L "$script_path" ]; do
	script_dir="$(cd "$(dirname "$script_path")" && pwd)"
	script_path="$(readlink "$script_path")"

	if [[ "$script_path" != /* ]]; then
		script_path="${script_dir}/${script_path}"
	fi
done

repo_dir="$(cd "$(dirname "$script_path")" && pwd)"
requested_port="${1:-8000}"

if [[ ! "$requested_port" =~ ^[0-9]+$ ]]; then
	echo "Usage: launch-ff [port]"
	exit 2
fi

port_is_busy() {
	lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

port="$requested_port"

if [ "$#" -eq 0 ]; then
	while port_is_busy "$port"; do
		port=$((port + 1))
	done
elif port_is_busy "$port"; then
	echo "Port ${port} is already in use. Try another port, for example:"
	echo "  launch-ff $((port + 1))"
	exit 1
fi

url="http://127.0.0.1:${port}/index.html"

cd "$repo_dir"

echo "Serving FoxyFurniture at ${url}"
echo "Press Ctrl-C to stop."

python3 -m http.server "$port" --bind 127.0.0.1 >/dev/null 2>&1 &
server_pid="$!"

cleanup() {
	kill "$server_pid" >/dev/null 2>&1 || true
}

trap cleanup EXIT INT TERM

for _ in {1..30}; do
	if curl -fsI "$url" >/dev/null 2>&1; then
		break
	fi

	if ! kill -0 "$server_pid" >/dev/null 2>&1; then
		echo "The local server could not start."
		exit 1
	fi

	sleep 0.1
done

if command -v open >/dev/null 2>&1; then
	open "$url" >/dev/null 2>&1 || true
fi

wait "$server_pid"
