#!/usr/bin/env bash

set -euo pipefail

script_path="${BASH_SOURCE[0]}"

while [ -L "$script_path" ]; do
	script_dir="$(cd "$(dirname "$script_path")" && pwd)"
	script_path="$(readlink "$script_path")"

	if [[ "$script_path" != /* ]]; then
		script_path="${script_dir}/${script_path}"
	fi
done

repo_dir="$(cd "$(dirname "$script_path")" && pwd)"
bind_address="127.0.0.1"
open_browser=true
requested_port="8000"
port_was_requested=false

for arg in "$@"; do
	case "$arg" in
	--lan)
		bind_address="0.0.0.0"
		;;
	--no-open)
		open_browser=false
		;;
	-h|--help)
		echo "Usage: launch-ff [--lan] [--no-open] [port]"
		exit 0
		;;
	*)
		if [[ "$arg" =~ ^[0-9]+$ ]]; then
			requested_port="$arg"
			port_was_requested=true
		else
			echo "Usage: launch-ff [--lan] [--no-open] [port]"
			exit 2
		fi
		;;
	esac
done

if [[ ! "$requested_port" =~ ^[0-9]+$ ]]; then
	echo "Usage: launch-ff [--lan] [--no-open] [port]"
	exit 2
fi

port_is_busy() {
	lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

port="$requested_port"

if ! $port_was_requested; then
	while port_is_busy "$port"; do
		port=$((port + 1))
	done
elif port_is_busy "$port"; then
	echo "Port ${port} is already in use. Try another port, for example:"
	echo "  launch-ff $((port + 1))"
	exit 1
fi

local_url="http://127.0.0.1:${port}/index.html"
display_url="$local_url"

if [ "$bind_address" = "0.0.0.0" ]; then
	default_interface="$(route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}')"
	lan_address=""

	if [ -n "$default_interface" ]; then
		lan_address="$(ipconfig getifaddr "$default_interface" 2>/dev/null || true)"
	fi

	if [ -n "$lan_address" ]; then
		display_url="http://${lan_address}:${port}/index.html"
	fi
fi

cd "$repo_dir"

echo "Serving FoxyFurniture at ${local_url}"

if [ "$bind_address" = "0.0.0.0" ]; then
	echo "From your phone, try ${display_url}"

	if [ "$display_url" = "$local_url" ]; then
		echo "Could not identify the Mac's local network address automatically."
		echo "In System Settings > Wi-Fi > Details, look for your Mac's IP address."
	fi
fi

echo "Press Ctrl-C to stop."

python3 -m http.server "$port" --bind "$bind_address" >/dev/null 2>&1 &
server_pid="$!"

cleanup() {
	kill "$server_pid" >/dev/null 2>&1 || true
}

trap cleanup EXIT INT TERM

for _ in {1..30}; do
	if curl -fsI "$local_url" >/dev/null 2>&1; then
		break
	fi

	if ! kill -0 "$server_pid" >/dev/null 2>&1; then
		echo "The local server could not start."
		exit 1
	fi

	sleep 0.1
done

if $open_browser && command -v open >/dev/null 2>&1; then
	open "$local_url" >/dev/null 2>&1 || true
fi

wait "$server_pid"
